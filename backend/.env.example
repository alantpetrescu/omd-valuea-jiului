# OMD Valea Jiului — backend environment
# Copy to .env and fill in. .env is never committed.
# Variable names follow FULLSTACK_IMPLEMENTATION_SPEC_v1_5.md section 6.

APP_ENV=staging
APP_BASE_URL=http://localhost:3000
APP_SECRET=change-me-long-random-string
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=omd_vj_staging
DB_USER=omd_app
DB_PASSWORD=

# Relative paths are resolved from the repository root (the folder holding backend/).
# An absolute path is also accepted — production will normally use one.
UPLOAD_DIR=storage/uploads
IMPORT_TEMP_DIR=storage/import-temp
MAX_UPLOAD_MB=15
MAX_JSON_IMPORT_MB=25

AUTH_SECRET=change-me-different-long-random-string
AUTH_TOKEN_TTL=28800

LOG_LEVEL=info

# Optional
# Number of proxies in front of the app (nginx = 1). Without it req.ip is
# the proxy, so the login rate limiter counts every user as one client.
# TRUST_PROXY=1
# ALLOWED_ORIGIN=
# BACKUP_DIR=

# Bind address (default 0.0.0.0). Behind a reverse proxy, use 127.0.0.1.
HOST=0.0.0.0

# Initial ADMIN created by `npm run seed:technical`
SEED_ADMIN_EMAIL=admin@omd.ro
SEED_ADMIN_NAME=Administrator OMD
