# Nothing above public/ is web-readable.
#
# On a shared host the whole application directory may sit inside the docroot,
# in which case this file is the only thing standing between the internet and
# .env, src/ and vendor code. Prefer placing backend-php/ outside public_html
# entirely; this is the fallback.

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
