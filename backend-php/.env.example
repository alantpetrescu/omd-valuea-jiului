# Configuration for the PHP backend.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Every value is validated at startup; a missing critical one refuses the
# request rather than half-working. See src/Config/Env.php.
#
# Real environment variables win over this file, so a cPanel panel setting or
# an .htaccess SetEnv overrides what is written here.

# staging | production. Drives Secure cookies and whether error details leak.
APP_ENV=production
APP_BASE_URL=https://exemplu.ro

# Two DIFFERENT random values, 32+ characters each.
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
#
# AUTH_SECRET must match the Node backend's if both run against the same
# database — sessions are signed with it, and a mismatch logs everyone out.
APP_SECRET=change-me-long-random-string
AUTH_SECRET=change-me-different-long-random-string
AUTH_TOKEN_TTL=28800

# On cPanel the database and user carry the account prefix, e.g. myuser_omd.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=omd_vj_production
DB_USER=omd_app
DB_PASSWORD=

# Absolute paths, or relative to the repository root (the folder holding
# backend-php/, contracts/ and database/).
UPLOAD_DIR=storage/uploads
IMPORT_TEMP_DIR=storage/import-temp
MAX_UPLOAD_MB=15
MAX_JSON_IMPORT_MB=25

# The initial ADMIN created by bin/seed-technical.php
SEED_ADMIN_EMAIL=admin@omd.ro
SEED_ADMIN_NAME=Administrator OMD

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Leave empty to use PHP's error log (cPanel: the account's logs/ directory).
LOG_FILE=

# How many proxies sit in front of the app.
#
#   0  Apache or PHP-FPM serves the request directly. Shared hosting, cPanel.
#   1  one reverse proxy adds X-Forwarded-For — nginx, CloudFlare, a load balancer.
#
# Set it to the real number, and 0 when unsure. Too low only means the rate
# limiter sees the proxy instead of the visitor. Too high is worse: the app
# then trusts an X-Forwarded-For that nothing wrote, so a caller can send a
# different one on every attempt and never trip the login limiter.
TRUST_PROXY=0
