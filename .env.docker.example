# Deployment configuration. Copy to .env.docker and fill in.
# .env.docker is gitignored and must never be committed.

# --- Tailscale ---
# Auth key from https://login.tailscale.com/admin/settings/keys
# Use a reusable key; tag it (e.g. tag:omd) if you use ACLs.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
TS_HOSTNAME=omd-valea-jiului

# --- Application ---
# The MagicDNS name Tailscale issues, with https://
APP_BASE_URL=https://omd-valea-jiului.tailXXXX.ts.net
# Generate each with: openssl rand -hex 32
APP_SECRET=
AUTH_SECRET=
AUTH_TOKEN_TTL=28800

# --- Database ---
# Must be reachable from the tailscale network namespace: a host address,
# another tailnet node (100.x.y.z or its MagicDNS name), or a managed server.
DB_HOST=
DB_PORT=3306
DB_NAME=omd_vj_production
DB_USER=omd_app
DB_PASSWORD=

# --- Limits and logging ---
MAX_UPLOAD_MB=15
MAX_JSON_IMPORT_MB=25
LOG_LEVEL=info

# --- Initial admin (created by seed:technical) ---
SEED_ADMIN_EMAIL=admin@omd.ro
SEED_ADMIN_NAME=Administrator OMD
