{
  "name": "omd-vj-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File ../tests/run.ps1",
    "test:frontend": "powershell -NoProfile -ExecutionPolicy Bypass -File ../tests/frontend/run.ps1 -All",
    "test:backend": "php ../tests/backend/run.php",
    "test:hybrid": "powershell -NoProfile -ExecutionPolicy Bypass -File ../tests/hybrid/run.ps1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
