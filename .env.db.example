# Settings for docker-compose.db.yml — the database-only container.
#
#   cp .env.db.example .env.db
#   docker compose -f docker-compose.db.yml --env-file .env.db up -d
#
# Keep .env.db out of version control: it holds two passwords.

# Root account. Used for administration and dumps, never by the application.
DB_ROOT_PASSWORD=change-me-root

# The database and the account the application connects with. Creating them
# here also grants that account ALL privileges on this one schema, which is
# what the migration runner needs.
DB_NAME=omd_vj_production
DB_USER=omd_app
DB_PASSWORD=change-me-app

# Where the container publishes the port on the host.
#
# 127.0.0.1 means only this machine can reach it. Change it to 0.0.0.0 only if
# something on another host must connect, and put a firewall rule or a tunnel
# in front when you do — an exposed MySQL port is scanned within hours.
DB_BIND=127.0.0.1
DB_PORT=3306
