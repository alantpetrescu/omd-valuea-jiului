# Upload to public_html/app/.htaccess
#
# Single-page application fallback. The React router owns every path under
# /app/, but the browser asks the server first on a fresh load or a refresh, and
# there is no file at /app/campaigns. Without this rule that is a 404 — the
# classic "works until you press F5" bug.
#
# RewriteBase is explicit because the rule below is relative, and a subdirectory
# deployment is exactly the case where Apache's guess is wrong.

RewriteEngine On
RewriteBase /app/

# A real file or directory wins: assets, fonts, index.html itself.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else is a client-side route.
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # The hashed asset filenames change on every build, so they can be cached
  # hard. index.html must not be, or a deploy would not reach anyone.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

Options -Indexes
