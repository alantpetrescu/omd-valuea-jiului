# Upload to public_html/app/.htaccess
#
# Single-page application fallback. The React router owns every path under
# /app/, but the browser asks the server first on a fresh load or a refresh, and
# there is no file at /app/campaigns. Without this rule that is a 404 — the
# classic "works until you press F5" bug.
#
# RewriteBase is explicit because the rule below is relative, and a subdirectory
# deployment is exactly the case where Apache's guess is wrong.

RewriteEngine On
RewriteBase /app/

# A real file or directory wins: assets, fonts, index.html itself.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else is a client-side route.
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Caching, ordered so the specific rule wins.
  #
  # The first version matched every .js, .css and .woff2 and marked them all
  # immutable for a year. That is right for hashed build output, whose filename
  # changes whenever the content does — and wrong for anything whose name is
  # stable. fonts.css sits in public/, so it keeps its name across deploys: once
  # a browser had it, immutable meant it would never ask for it again, and a fix
  # to it could not reach anyone. That is exactly what happened.

  # Default for files that keep their name from one deploy to the next.
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Hashed build output overrides it: `index-DFrcpxsr.css` and friends.
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # A given .woff2 is never edited, only added or removed.
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

Options -Indexes
