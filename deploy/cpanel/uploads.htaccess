# Upload to public_html/uploads/.htaccess
#
# This directory holds images the application decoded out of import packages and
# wrote itself. Apache serves them straight off disk, which is why UPLOAD_DIR
# points inside the document root: no PHP process per image.
#
# The trade is that anything written here is web-reachable, so execution is
# turned off. The application only ever writes images with server-generated
# names, but "only ever" is an assumption about code, and this is a rule about
# the directory.

<FilesMatch "\.(php|phtml|php[0-9]|phar|cgi|pl|py|sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_php.c>
  php_flag engine off
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header set Cache-Control "public, max-age=3600"
</IfModule>

Options -Indexes -ExecCGI
AddHandler default-handler .php .phtml .phar .cgi .pl .py .sh
